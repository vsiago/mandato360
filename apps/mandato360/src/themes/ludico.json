{
  "id": "ludico",
  "nome": "Lúdico",
  "descricao": "Vibrante, divertido e acolhedor. Formas orgânicas.",
  "emoji": "🎨",
  "preview": "#FFF5F7",

  "colors": {
    "light": {
      "primary": "#1A1A2E",
      "secondary": "#64748B",
      "accent": "#F43F5E",
      "background": "#FFFBFE",
      "surface": "#FFF1F3",
      "text": "#1A1A2E",
      "textMuted": "#64748B",
      "border": "#FECDD3"
    },
    "dark": {
      "primary": "#FFF1F3",
      "secondary": "#94A3B8",
      "accent": "#FB7185",
      "background": "#0F0A0C",
      "surface": "#1C1218",
      "text": "#FFF1F3",
      "textMuted": "#94A3B8",
      "border": "#3B1C28"
    }
  },
  "typography": {
    "heading": "Poppins",
    "body": "Inter",
    "headingWeight": "900",
    "bodyWeight": "400"
  },
  "buttons": {
    "style": "pill",
    "shadow": true,
    "borderWidth": 0
  },
  "cards": {
    "shadow": "lg",
    "border": false,
    "borderRadius": "48px",
    "backdrop": true
  },
  "animations": {
    "hoverScale": true,
    "fadeIn": true,
    "staggerChildren": true,
    "duration": "normal"
  },
  "spacing": {
    "sectionPadding": "80px 0",
    "cardPadding": "32px",
    "borderRadius": "48px",
    "gap": "24px"
  },
  "cssVariables": {
    "--theme-radius": "48px",
    "--theme-font-heading": "'Poppins', sans-serif",
    "--theme-font-body": "'Inter', sans-serif",
    "--theme-shadow": "0 20px 50px rgba(244,63,94,0.12)",
    "--theme-transition": "400ms cubic-bezier(0.34, 1.56, 0.64, 1)",
    "--theme-btn-radius": "9999px",
    "--theme-section-py": "80px",
    "--theme-card-py": "32px"
  }
}
