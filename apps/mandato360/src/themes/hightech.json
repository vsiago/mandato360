{
  "id": "hightech",
  "nome": "Hightech",
  "descricao": "Futurista, técnico e ousado. Geometria purista.",
  "emoji": "⚡",
  "preview": "#0A0A14",

  "colors": {
    "light": {
      "primary": "#0F172A",
      "secondary": "#475569",
      "accent": "#00F2FF",
      "background": "#F8FAFC",
      "surface": "#F1F5F9",
      "text": "#0F172A",
      "textMuted": "#475569",
      "border": "#0F172A"
    },
    "dark": {
      "primary": "#F8FAFC",
      "secondary": "#94A3B8",
      "accent": "#00F2FF",
      "background": "#020617",
      "surface": "#0F172A",
      "text": "#F8FAFC",
      "textMuted": "#94A3B8",
      "border": "#334155"
    }
  },
  "typography": {
    "heading": "Outfit",
    "body": "Inter",
    "headingWeight": "900",
    "bodyWeight": "400"
  },
  "buttons": {
    "style": "sharp",
    "shadow": true,
    "borderWidth": 2
  },
  "cards": {
    "shadow": "glow",
    "border": true,
    "borderRadius": "0px",
    "backdrop": true
  },
  "animations": {
    "hoverScale": true,
    "fadeIn": true,
    "staggerChildren": true,
    "duration": "fast"
  },
  "spacing": {
    "sectionPadding": "80px 0",
    "cardPadding": "32px",
    "borderRadius": "0px",
    "gap": "1px"
  },
  "cssVariables": {
    "--theme-radius": "0px",
    "--theme-font-heading": "'Outfit', sans-serif",
    "--theme-font-body": "'Inter', sans-serif",
    "--theme-shadow": "0 0 40px rgba(0,242,255,0.15)",
    "--theme-transition": "100ms cubic-bezier(0, 1.2, 1, 1)",
    "--theme-btn-radius": "0px",
    "--theme-section-py": "80px",
    "--theme-card-py": "32px"
  }
}
