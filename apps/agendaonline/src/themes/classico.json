{
  "id": "classico",
  "nome": "Clássico",
  "descricao": "Elegante, atemporal e luxuoso. Tipografia serifada vintage, tons quentes e sofisticação artesanal.",
  "emoji": "🏛️",
  "preview": "#1a1410",

  "colors": {
    "light": {
      "primary": "#1C1917",
      "secondary": "#78716C",
      "accent": "#C4956A",
      "background": "#FAF8F5",
      "surface": "#F2EDE8",
      "text": "#1C1917",
      "textMuted": "#78716C",
      "border": "#D6CFC7"
    },
    "dark": {
      "primary": "#F5F0EB",
      "secondary": "#A89F97",
      "accent": "#D4A574",
      "background": "#0C0A08",
      "surface": "#1A1410",
      "text": "#F5F0EB",
      "textMuted": "#A89F97",
      "border": "#3D3530"
    }
  },
  "typography": {
    "heading": "Playfair Display",
    "body": "Cormorant Garamond",
    "headingWeight": "700",
    "bodyWeight": "400"
  },
  "buttons": {
    "style": "soft",
    "shadow": true,
    "borderWidth": 1
  },
  "cards": {
    "shadow": "md",
    "border": true,
    "borderRadius": "4px",
    "backdrop": false
  },
  "animations": {
    "hoverScale": true,
    "fadeIn": true,
    "staggerChildren": true,
    "duration": "slow"
  },
  "spacing": {
    "sectionPadding": "120px 0",
    "cardPadding": "40px",
    "borderRadius": "4px",
    "gap": "28px"
  },
  "cssVariables": {
    "--theme-radius": "4px",
    "--theme-font-heading": "'Playfair Display', serif",
    "--theme-font-body": "'Cormorant Garamond', serif",
    "--theme-shadow": "0 20px 60px rgba(0,0,0,0.08)",
    "--theme-transition": "600ms cubic-bezier(0.2, 0, 0, 1)",
    "--theme-btn-radius": "2px",
    "--theme-section-py": "120px",
    "--theme-card-py": "40px",
    "--theme-letter-spacing-heading": "-0.02em",
    "--theme-letter-spacing-body": "0.01em"
  }
}
